    {
      "cell_type": "markdown",
      "metadata": {
        "id": "9d9b7d30"
      },
      "source": [
        "# **Commonest Crime Type and Trends Over Time**\n",
        "\n",
        "First, let's convert the 'DATE OCC' column to datetime objects to enable proper temporal analysis."
      ],
      "id": "9d9b7d30"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 679
        },
        "id": "3b41d2d5",
        "outputId": "9d7ab7a9-8f28-4b03-9b58-2285664ec0ef"
      },
      "source": [
        "# Convert 'DATE OCC' to datetime objects for accurate temporal analysis\n",
        "crimes['DATE OCC'] = pd.to_datetime(crimes['DATE OCC'])\n",
        "\n",
        "# Group by date of occurrence and count crimes\n",
        "daily_crime_counts = crimes['DATE OCC'].value_counts().sort_index()\n",
        "\n",
        "# Plotting the crime rates over time\n",
        "plt.figure(figsize=(15, 7))\n",
        "daily_crime_counts.plot(kind='line', marker='o', linestyle='-', color='skyblue')\n",
        "plt.title('Daily Crime Occurrences Over Time')\n",
        "plt.xlabel('Date of Occurrence')\n",
        "plt.ylabel('Number of Crimes')\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# To determine if rates are increasing or decreasing, we can look at a longer trend or specific periods\n",
        "# For a simple assessment, we can compare the average of the first and last parts of the data.\n",
        "if len(daily_crime_counts) > 0:\n",
        "    first_half_avg = daily_crime_counts.iloc[:len(daily_crime_counts)//2].mean()\n",
        "    second_half_avg = daily_crime_counts.iloc[len(daily_crime_counts)//2:].mean()\n",
        "    print(f\"\\nAverage crimes in first half: {first_half_avg:.2f}\")\n",
        "    print(f\"Average crimes in second half: {second_half_avg:.2f}\")\n",
        "\n",
        "    if second_half_avg > first_half_avg:\n",
        "        print(\"Crime rates appear to be generally increasing over the observed period.\")\n",
        "    elif second_half_avg < first_half_avg:\n",
        "        print(\"Crime rates appear to be generally decreasing over the observed period.\")\n",
        "    else:\n",
        "        print(\"Crime rates appear to be stable over the observed period.\")\n",
        "else:\n",
        "    print(\"No daily crime data to analyze trends.\")"
      ],
      "id": "3b41d2d5",
      "execution_count": 26,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1500x700 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Average crimes in first half: 2.83\n",
            "Average crimes in second half: 42.11\n",
            "Crime rates appear to be generally increasing over the observed period.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
